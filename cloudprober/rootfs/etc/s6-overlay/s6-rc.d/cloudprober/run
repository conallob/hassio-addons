#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start Cloudprober
# ==============================================================================

CLOUDPROBER_CONFIG_PATH="/data/cloudprober/cloudprober.cfg"

bashio::log.info "Starting Cloudprober with ${CLOUDPROBER_CONFIG_PATH}"

# Cloudprober reads its listen port from this env var; 9313 is its default and
# the add-on's ingress_port.
export CLOUDPROBER_PORT=9313

# Cloudprober's gRPC server only starts when a gRPC port is configured; there
# is no built-in default. When grpc_enabled is set, listen on 9314 (the port
# pre-declared in config.yaml). A `grpc_port` in the config itself takes
# precedence over this variable.
if bashio::config.true 'grpc_enabled'; then
    export CLOUDPROBER_GRPC_PORT=9314
    bashio::log.info "gRPC server enabled on port ${CLOUDPROBER_GRPC_PORT}"
fi

exec /usr/bin/cloudprober \
    --config_file "${CLOUDPROBER_CONFIG_PATH}"
